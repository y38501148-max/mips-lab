{
  "name": "mips-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3210",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "tsx --test tests/*.test.ts",
    "setup:mars": "node scripts/setup-mars.mjs",
    "start:local": "docker compose up -d",
    "stop:local": "docker compose stop",
    "status": "docker compose ps",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=80",
    "docker:status": "docker compose ps",
    "docker:build": "docker compose build",
    "docker:sync-proxy": "node docker/configure.mjs",
    "start:native": "node scripts/service.mjs start",
    "stop:native": "node scripts/service.mjs stop",
    "status:native": "node scripts/service.mjs status"
  },
  "dependencies": {
    "@ant-design-vue/nuxt": "1.4.6",
    "@ant-design/icons-vue": "^7.0.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "ant-design-vue": "4.2.6",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "nuxt": "4.6.2",
    "undici": "^7.30.1",
    "vue": "^3.5.22",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.18.0",
    "node": "^24.22.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.0"
  }
}
